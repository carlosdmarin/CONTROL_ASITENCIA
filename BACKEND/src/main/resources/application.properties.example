# Plantilla de configuración externa de seguridad para PractiQR.
# No colocar secretos reales en este archivo. Proveer los valores mediante variables
# de entorno u otro mecanismo local ignorado por Git.
#
# Variables requeridas:
# JWT_SECRET
# DB_URL
# DB_USERNAME
# DB_PASSWORD
#
# Variables necesarias según el entorno:
# JWT_COOKIE_SECURE
# CORS_ALLOWED_ORIGINS

# Base de datos: valores externos obligatorios.
spring.datasource.url=${DB_URL}
spring.datasource.username=${DB_USERNAME}
spring.datasource.password=${DB_PASSWORD}

# JWT: JWT_SECRET es obligatorio y debe tener al menos 32 bytes para HS256.
jwt.secret=${JWT_SECRET}

# Cookie JWT en desarrollo local HTTP.
# Puede usarse SPRING_PROFILES_ACTIVE=dev o configuración local explícita.
jwt.cookie.secure=false
# Cookie JWT en producción HTTPS.
# Usar SPRING_PROFILES_ACTIVE=prod, que exige Secure=true.
# jwt.cookie.secure=true

# CORS con allowlist explícita separada por comas. No usar comodines permanentes.
# Desarrollo:
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://xxxxx.trycloudflare.com
# Producción posterior:
# CORS_ALLOWED_ORIGINS=https://subdominio.olamsa.com

# Logs seguros por defecto: no exponer SQL ni parámetros vinculados.
spring.jpa.show-sql=false
spring.jpa.properties.hibernate.format_sql=false
logging.level.com.asistencia.attendance_system=INFO
logging.level.org.hibernate.SQL=WARN
logging.level.org.hibernate.orm.jdbc.bind=WARN
logging.level.org.hibernate.type.descriptor.sql.BasicBinder=WARN

# Alternativa solamente para depuración local explícita:
# spring.jpa.show-sql=true
# spring.jpa.properties.hibernate.format_sql=true
# logging.level.com.asistencia.attendance_system=DEBUG
# logging.level.org.hibernate.SQL=DEBUG
# logging.level.org.hibernate.type.descriptor.sql.BasicBinder=TRACE
